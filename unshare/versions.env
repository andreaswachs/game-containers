# Minecraft Unshare Server Versions
# Image tag lives in image.yaml; these values configure image build args
# Note: MINECRAFT_VERSION_URL is the URL-encoded form of "3D Shareware v1.34"
# (CI passes these through xargs, so no spaces are allowed in values)

MINECRAFT_VERSION_URL=3D%20Shareware%20v1.34
FABRIC_LOADER_VERSION=0.16.5
MIXIN_VERSION=0.15.3%2Bmixin.0.8.7
JAVA_PACKAGE=openjdk21-jre
